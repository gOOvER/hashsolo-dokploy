# Bitcoin Core (integrated bitcoind service)
BITCOIN_RPC_USER=hashsolo
BITCOIN_RPC_PASSWORD=change_this_to_a_strong_password
# 550 = pruned (~10 GB disk), 0 = full unpruned node (~700+ GB)
BITCOIN_PRUNE=550

# HashSolo Pool Settings
NETWORK=mainnet
POOL_IDENTIFIER=HashSolo
# DEV_FEE_ADDRESS=

# HashSolo UI (Stratum URL shown to miners & optional footer customization)
PUBLIC_POOL_STRATUM_URL=stratum.goover.dev:3333
# DONATION_BTC_ADDRESS=
# DONATION_URL=
# DONATION_LINK_LABEL=
# DONATION_TITLE=
# DONATION_SUBTITLE=

# Optional Security & Notifications
# SHARE_SUBMISSION_API_KEY=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# DISCORD_BOT_CLIENTID=
# DISCORD_BOT_GUILD_ID=
# DISCORD_BOT_CHANNEL_ID=
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=hashsolo
# NTFY_TOKEN=
# BEST_DIFF_ALERT_MIN=1000000000
# DEVICE_NOTIFICATIONS_ENABLED=true
# STRATUM_START_DIFF=
# VARDIFF_TARGET_TIME=10
# VARDIFF_MIN_DIFF=0.00001
