# Bitcoin Core RPC / ZMQ
BITCOIN_RPC_URL=http://host.docker.internal
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_TIMEOUT=10000
BITCOIN_RPC_COOKIEFILE=
# BITCOIN_ZMQ_HOST=tcp://host.docker.internal:3000

# HashSolo Pool Settings
NETWORK=mainnet
STRATUM_PORT=3333
API_PORT=3334
API_SECURE=false
STRATUM_MAX_CONNECTIONS_PER_LISTENER=10000
POOL_IDENTIFIER=HashSolo
DEV_FEE_ADDRESS=

# Security
SHARE_SUBMISSION_API_KEY=
CORS_ORIGIN=https://pool.example.com

# HashSolo UI Runtime Config (Dokploy Domains)
PUBLIC_POOL_API_URL=https://api.pool.example.com
PUBLIC_POOL_STRATUM_URL=stratum+tcp://pool.example.com:3333
UI_LOGLEVEL=INFO
UI_LOGFORMAT=json

# Optional Notifications
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENTID=
DISCORD_BOT_GUILD_ID=
DISCORD_BOT_CHANNEL_ID=
